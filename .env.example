SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.vercel.app,localhost
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:8000

# External Database (Vercel has no built-in DB — use Neon, Supabase, or Railway)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Resend Email (free: 100 emails/day)
RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_EMAIL=RENIC ERP <noreply@yourdomain.com>
