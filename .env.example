SECRET_KEY=your-50-char-random-secret-key
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app,localhost
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,http://127.0.0.1:8000

# Database (PostgreSQL)
DB_NAME=distance_erp
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Resend Email (free: 100 emails/day)
RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_EMAIL=RENIC ERP <noreply@yourdomain.com>

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_API_KEY=your_phonepe_api_key
PHONEPE_SALT_INDEX=0
PHONEPE_SALT_KEY=your_phonepe_salt_key
