SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.vercel.app,localhost
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:8000

# External Database (Vercel has no built-in DB — use Neon, Supabase, or Railway)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# For local development (no DATABASE_URL needed)
# DB_NAME=distance_erp
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
